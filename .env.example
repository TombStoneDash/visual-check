# Phase 2 — Daisy deploy-gate integration.
# Copy to .env and fill in the values before running `visual-check deploy-gate`.
# Never commit .env. The project root .gitignore already excludes it.

# Supabase — project URL + service-role key (Settings → API).
SUPABASE_URL=<your-supabase-url>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Telegram — bot token from @BotFather and your private chat id.
# Get the chat id by messaging @userinfobot (Telegram) or visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates after the bot receives
# a message.
TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
TELEGRAM_CHAT_ID=<your-telegram-chat-id>
